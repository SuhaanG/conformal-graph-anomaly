__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
results/logs/*
!results/logs/.gitkeep

# results/published/ is deliberately NOT ignored. results/logs/ is scratch --
# rerun freely, overwrite freely. Anything a paper claim depends on gets
# copied into results/published/ and committed, because the degree-confound
# numbers existed only inside commit messages for a while and that is not a
# place results can live. See results/published/README.md.
.DS_Store

# Dataset caches downloaded at runtime by the PyTorch Geometric / PyGOD /  DGL
# loaders in scripts/real_data_experiment.py. These are re-downloadable derived
# data, not source. tmp_tolokers/ was committed once by accident (17.1 MB) --
# git keeps blobs in history forever, so every clone pays for it until the
# history is rewritten separately.
tmp_tolokers/
tmp_*/
*_data/